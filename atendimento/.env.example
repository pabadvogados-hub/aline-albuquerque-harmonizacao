# Central de atendimento (estilo ManyChat) da Dra. Aline
# Copie para atendimento/.env (ou acrescente estas linhas no config/.env) e preencha.
# Nunca envie este arquivo preenchido para ninguem nem para o GitHub.

# Senha de acesso a central (tela web). Use uma senha forte.
ATEND_SENHA=
# Chave para assinar o cookie de login (qualquer texto longo e aleatorio). Opcional.
ATEND_CHAVE=

# Webhook da Meta
# Texto qualquer que voce inventa e cola tambem no painel do app (campo "Verificar token").
ATEND_VERIFY_TOKEN=
# "Chave secreta do app" (App Secret) em developers.facebook.com > app > Configuracoes > Basico.
# Sem ela o webhook recusa tudo (exceto em simulacao).
META_APP_SECRET=

# Token DA PAGINA do Facebook ligada ao Instagram da Dra. (permanente, gerado pelo usuario do sistema).
ATEND_PAGE_TOKEN=
# Id da conta profissional do Instagram e da Pagina (para o robo nao responder a propria clinica).
META_IG_USER_ID=
META_PAGE_ID=

# Opcional: URL que recebe um POST (JSON) quando um lead fica qualificado ou pede humano
# (ex.: webhook do sistema PAB, n8n, Zapier). Vazio = so registra no log.
ATEND_NOTIFICAR_URL=

# 1 = modo simulacao: nada sai para a Meta, tudo fica so no banco/log. Use para testar.
ATEND_SIMULAR=0

# Opcional
# META_API_VERSION=v21.0
# ATEND_DB=caminho/para/atendimento.db
